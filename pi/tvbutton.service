[Unit]
Description=Simpsons TV power knob
# Early, and before the player: it has to know at its first frame whether the TV is "on".
# (The guide's After=multi-user.target held this back until the network was up, ~30 s.)
Before=tvplayer.service

[Service]
WorkingDirectory=/home/jason/simpsonstv
ExecStart=/usr/bin/python3 /home/jason/simpsonstv/buttons.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
